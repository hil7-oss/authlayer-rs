# AuthLayer environment contract
# ==============================
# Docker Compose:  cp .env.example .env   (Compose reads .env automatically)
# systemd:         copy to /etc/authlayer/authlayer.env
#
# Never commit the real .env. Generate secrets with: openssl rand -hex 32
#
# This template is intentionally fail-closed. `docker compose config` parses
# it, but AuthLayer refuses to start until OTP_SECRET and SMTP are configured
# and auth.example.com is replaced. That distinction is expected: Compose
# validates YAML/interpolation, while the application validates its config.
#
# UPGRADE WARNING: migration 0003 invalidates legacy sessions created before
# passkey binding and legacy recovery codes with no expiry. Production now uses
# the __Host-al_session cookie, so old al_session cookies are ignored. Affected
# users must sign in again and regenerate recovery codes. Old HMAC admin cookies
# are invalid (admin sessions are now server-side). Back up the database first.

# --- Listener ---------------------------------------------------------------
# Docker Compose: keep 0.0.0.0:8080; the port is internal to the Compose bridge.
# systemd behind Caddy on the same host: use 127.0.0.1:8080.
BIND_ADDR=0.0.0.0:8080

# --- Public identity --------------------------------------------------------
# Exact origin users open in a browser. Must be https in production, with no
# trailing slash. The WebAuthn origin and Origin-header check derive from it.
APP_URL=https://auth.example.com

# WebAuthn Relying Party ID. Hostname only: no scheme, port or path.
# When DEV_MODE=false it must equal the APP_URL host unless
# ALLOW_RP_ID_PARENT=true. Changing it invalidates existing passkeys.
RP_ID=auth.example.com

# Default false. Set true only to intentionally scope passkeys to a parent
# domain (for example example.com for auth.example.com). This broadens the
# WebAuthn RP scope; leave false for the exact host.
ALLOW_RP_ID_PARENT=false

# Human-readable name shown in browser passkey prompts.
RP_NAME=AuthLayer

# --- Database ---------------------------------------------------------------
# SQLite path. Docker: /data is the authlayer_data volume.
# systemd: sqlite:///var/lib/authlayer/authlayer.db?mode=rwc
DATABASE_URL=sqlite:///data/authlayer.db?mode=rwc

# --- Secrets ----------------------------------------------------------------
# REQUIRED when DEV_MODE=false. At least 32 characters, random, and not one of
# the known placeholders (placeholders are rejected in every mode). Generate:
#   openssl rand -hex 32
# In local development you may remove it to use an ephemeral key, but codes then
# die on restart. The placeholder below is deliberately rejected at startup.
# Keep the real value stable: rotating it invalidates pending OTPs and every
# unused recovery code.
OTP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Optional. Leave empty to disable all /admin routes (they return 404).
# If set, it must be at least 32 characters and not a known placeholder:
#   openssl rand -hex 32
# Admin login is a form at /admin/login; the token is never accepted in the URL.
# Sessions are server-side now: only a token hash is stored in admin_sessions.
# The opaque al_admin cookie is HttpOnly, SameSite=Strict, Path=/admin, 1 hour,
# and Secure when COOKIE_SECURE=true. Logout revokes the DB row. Old HMAC admin
# cookies are invalid. Changing ADMIN_TOKEN does not revoke existing sessions.
ADMIN_TOKEN=

# --- Cookies and sessions ---------------------------------------------------
# Production session cookie. The __Host- prefix requires Secure, Path=/ and no
# Domain; the app sets those. Non-dev startup rejects COOKIE_SECURE=false,
# a non-HTTPS APP_URL, or a COOKIE_NAME without the "__Host-" prefix.
# Local HTTP dev uses COOKIE_NAME=al_session and COOKIE_SECURE=false.
COOKIE_NAME=__Host-al_session

# Must be true for any HTTPS production deployment.
COOKIE_SECURE=true

# Absolute session lifetime in days.
SESSION_TTL_DAYS=7

# Reject a session after this many hours without an authenticated request.
# Any authenticated request refreshes the idle timer (within SESSION_TTL_DAYS).
SESSION_IDLE_HOURS=24

# The session cookie is HttpOnly and SameSite=Strict. Production state-changing
# requests require Origin exactly matching the APP_URL origin; browsers add it,
# but curl/API clients must send it manually. WebAuthn challenges are bound by
# the al_ceremony cookie (HttpOnly, SameSite=Strict, 10 min); clients driving
# WebAuthn manually must keep cookies and return both challenge_id and jar.

# --- OTP and recovery -------------------------------------------------------
# OTP lifetime in minutes.
OTP_TTL_MINUTES=10

# Recovery-code lifetime in days from generation.
RECOVERY_CODE_TTL_DAYS=365

# --- Development safety -----------------------------------------------------
# DEV_MODE is explicit and defaults to false; it is never auto-enabled.
# When true, BIND_ADDR and APP_URL must be loopback unless
# ALLOW_INSECURE_DEV_MODE=true. DEV_MODE=true exposes /dev/outbox.
DEV_MODE=false

# Escape hatch for isolated development only: permits DEV_MODE=true with a
# non-loopback BIND_ADDR/APP_URL. Never enable this on a public deployment.
ALLOW_INSECURE_DEV_MODE=false

# Escape hatch for staging only: permits EMAIL_PROVIDER=outbox while
# DEV_MODE=false. Users still receive no email; the app only logs a warning.
# Do not enable this in production.
ALLOW_OUTBOX_WITHOUT_DEV=false

# --- Email delivery ---------------------------------------------------------
# Production default: smtp. The app refuses to start while SMTP_HOST and
# SMTP_FROM are empty. That is intentional fail-closed behavior.
#
# outbox is for local development only: it records messages and sends nothing.
# Outbox with DEV_MODE=false fails startup unless ALLOW_OUTBOX_WITHOUT_DEV=true.
EMAIL_PROVIDER=smtp

# Fill these when EMAIL_PROVIDER=smtp:
#   - SMTP_HOST and SMTP_FROM are required
#   - SMTP_USERNAME and SMTP_PASSWORD must be set together, or both left empty
#   - SMTP_FROM is a mailbox: AuthLayer <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=required

# TLS modes:
#   required      - STARTTLS required on ports other than 465; port 465 uses
#                   implicit TLS. Required for production.
#   opportunistic - DEV_MODE only; rejected if SMTP credentials are set.
#   none          - no TLS at all. Rejected when DEV_MODE=false; insecure.
#
# Completed production example (copy these values into the active keys above;
# do not add duplicate keys):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=authlayer
#   SMTP_PASSWORD=replace-with-provider-smtp-password
#   SMTP_FROM="AuthLayer <no-reply@yourdomain.example>"
#   SMTP_TLS=required
#
# If a password contains spaces, "#", or "$", single-quote it in this file so
# Compose parses it literally. Never commit real SMTP credentials or paste them
# into logs.
#
# Common providers (verify sender/domain settings in their current docs):
#   Postmark:    smtp.postmarkapp.com:587; use the Server API token as both
#                SMTP_USERNAME and SMTP_PASSWORD.
#   Amazon SES:  email-smtp.<region>.amazonaws.com:587 (STARTTLS) or 465
#                (implicit TLS); use SES SMTP credentials, not IAM access keys.
#                SES sandbox accounts can only send to verified recipients.
#   Mailgun:     smtp.mailgun.org (US) or smtp.eu.mailgun.org (EU):587 or 465;
#                SMTP user is usually postmaster@yourdomain.
#   Generic:     use your provider's host and port; 587 = STARTTLS, 465 =
#                implicit TLS with SMTP_TLS=required.

# --- Trusted proxy ----------------------------------------------------------
# Docker Compose uses a dedicated bridge network with subnet 172.28.0.0/16.
# Keep this CIDR in sync with docker-compose.yml. Caddy overwrites
# X-Forwarded-For and X-Real-IP for requests it proxies.
#
# systemd behind Caddy on the same host: use TRUST_PROXY=true and
# TRUSTED_PROXY_CIDRS=127.0.0.1/32 instead.
#
# TRUSTED_PROXY_CIDRS is a comma-separated list of IPv4/IPv6 CIDRs. Forwarding
# headers are honored only when the socket peer is in this list. With
# TRUST_PROXY=false the headers are ignored and the socket peer is used.
#
# Do not publish the AuthLayer port. Docker's gateway is inside this CIDR, so a
# directly published 8080 would let clients spoof audit IPs/rate limits.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=172.28.0.0/16

# --- Logging (optional; not parsed by config.rs) ----------------------------
RUST_LOG=authlayer=info,tower_http=info

# ---------------------------------------------------------------------------
# Local development (plain cargo run, no TLS, no proxy)
# ---------------------------------------------------------------------------
# Replace the active values above with this local set. Do not add duplicate
# keys. Do not use DEV_MODE=true in Compose: Compose binds 0.0.0.0 and the app
# rejects that unless ALLOW_INSECURE_DEV_MODE=true.
#
# BIND_ADDR=127.0.0.1:8080
# APP_URL=http://localhost:8080
# RP_ID=localhost
# DATABASE_URL=sqlite://authlayer.db?mode=rwc
# COOKIE_NAME=al_session
# COOKIE_SECURE=false
# DEV_MODE=true
# ALLOW_INSECURE_DEV_MODE=false
# ALLOW_OUTBOX_WITHOUT_DEV=false
# EMAIL_PROVIDER=outbox
# OTP_SECRET=local-dev-only-secret-0123456789abcdef
# ADMIN_TOKEN=local-dev-admin-token-0123456789abcdef
# TRUST_PROXY=false
#
# The SMTP_* values are ignored in outbox mode. With DEV_MODE=true, codes are
# visible at http://localhost:8080/dev/outbox .
# Do not copy these local values into a public deployment.
