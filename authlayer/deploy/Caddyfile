# AuthLayer reverse proxy
#
# IMPORTANT: replace auth.example.com below with your real public hostname.
# The same hostname must be used for APP_URL and RP_ID in .env, otherwise
# WebAuthn ceremonies and the Origin check will fail.
#
# Caddy obtains and renews TLS certificates automatically. Before starting:
#   - create a DNS A/AAAA record for this hostname pointing at the server;
#   - allow inbound TCP 80 and TCP/UDP 443 through the firewall.
#
# Docker Compose: authlayer is the service DNS name on the Compose network.
# Plain systemd with Caddy on the same host: change the upstream to
# 127.0.0.1:8080 (see deploy/README.md).

auth.example.com {
	encode zstd gzip

	header {
		# One year HSTS. If any other subdomain is not HTTPS-only, remove
		# includeSubDomains before deploying.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No inline scripts. 'unsafe-inline' is only for styles so the optional
		# /admin and /dev/outbox pages (inline <style>) render correctly.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options "DENY"
		Permissions-Policy "publickey-credentials-get=(self), publickey-credentials-create=(self)"
		-Server
	}

	reverse_proxy authlayer:8080 {
		# Do not strip Origin: AuthLayer requires it on production
		# state-changing requests. Caddy forwards it unchanged.
		#
		# AuthLayer honors forwarding headers only when the socket peer is in
		# TRUSTED_PROXY_CIDRS (172.28.0.0/16 for the Compose network). Overwrite
		# both headers from the direct peer so a client cannot inject its own
		# audit/rate-limit IP. Caddy may call the explicit X-Forwarded-For
		# override "unnecessary"; it is intentional.
		#
		# If you put a CDN or another proxy in front of Caddy, configure Caddy's
		# global trusted_proxies and use {client_ip} for both headers; otherwise
		# every request appears to come from the CDN/proxy.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
